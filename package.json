{
  "name": "kindly",
  "version": "0.1.0-alpha",
  "private": true,
  "description": "Kindly \u2014 a warm, voice-first AI companion gift for aging parents. Alpha v0.1.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node db/migrate.mjs",
    "db:seed": "node db/seed.mjs",
    "admin:create": "node scripts/admin-create.mjs",
    "cron:weekly": "node scripts/cron.mjs weekly",
    "cron:purge": "node scripts/cron.mjs purge",
    "beta:invite": "node scripts/beta-invite.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:prompt-signoffs": "node scripts/check-prompt-signoffs.mjs",
    "test:redteam-live": "vitest run test/redteam-live"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.109.1",
    "@sentry/nextjs": "^10.76.2",
    "next": "15.5.28",
    "pg": "8.12.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stripe": "^22.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "20.14.0",
    "@types/pg": "8.11.6",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.28",
    "jsdom": "^29.1.1",
    "pg-mem": "3.0.3",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.6",
    "typescript": "5.5.3",
    "vitest": "2.1.9"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
