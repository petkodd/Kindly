# Dearly — environment variables (Alpha v0.1)
#
# Local quick start: `cp .env.example .env.local`, fill in the three secrets
# marked "Generate", and leave every [PAID] key empty. Without paid keys the
# app uses simulated AI, voice and email (see DEMO_MODE below). The README has
# a table of every variable.
#
# [PAID] marks a key from a paid provider. Never put a live/production key in
# .env.local on a shared machine, and never commit one.

# PostgreSQL with pgvector + citext. These values match docker-compose.yml
# (`docker compose up -d --wait`). On Vercel use Neon, Supabase or RDS.
DATABASE_URL=postgres://kindly:kindly@localhost:5432/kindly

# Set to "disable" for a local Postgres without SSL (the Docker database).
# Leave empty for managed Postgres, which uses verified TLS.
PGSSL=disable
# Optional: path to a PEM CA bundle for a private-CA Postgres (e.g. RDS).
# Certificates are always verified; db/migrate.mjs ignores sslmode= in DATABASE_URL.
PGSSLROOTCERT=

# Demo mode. "true" = always use the simulated AI, voice and email clients
# (even if paid keys are set) and show a "Demo mode: simulated AI & voice"
# badge in the app. Set it for a demo deploy, or locally to keep a demo free
# while paid keys sit in .env.local. Not needed for a keyless local run: with
# no keys the app already uses the simulated clients and shows the badge.
# On the production deploy (VERCEL_ENV=production) without DEMO_MODE=true, a
# missing AI/voice/email key is a hard error, never a silent fake.
DEMO_MODE=

# Password for the seeded demo accounts demo@kindly.test and admin@kindly.test
# (`npm run db:seed`). At least 8 characters. Local only.
DEMO_PASSWORD=

# [PAID] Anthropic API key for the companion and summaries. Empty = simulated
# AI locally; required on production unless DEMO_MODE=true.
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6
# Safety scan model: a small, fast model (defaults to claude-haiku-4-5, the
# signed default in src/lib/ai/prompts.ts). An override runs unsigned.
AI_SAFETY_MODEL=

# [PAID] Resend API key. Empty (or EMAIL_FROM empty) = simulated email locally:
# nothing is sent and deliveries are recorded as 'simulated'. Required on
# production unless DEMO_MODE=true.
EMAIL_API_KEY=
EMAIL_FROM=Dearly <hello@dearly.example.com>

# Public site URL (used for canonical/OG/sitemap). Production: the real domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side application base URL, used to build absolute links back into
# the app (currently: the Founding Family Beta invite script). Falls back to
# NEXT_PUBLIC_SITE_URL above if unset. See src/lib/appUrl.ts.
#
# In a Vercel Production environment, one of these two MUST be set — the app
# refuses to silently default to localhost there. Preview deploys and local
# dev fall back to http://localhost:3000 with nothing configured, but the
# `beta-invite.mjs create` script always requires one of these to be set
# explicitly (in any environment) before it will generate a link, so a real
# invite can never accidentally point at localhost.
APP_BASE_URL=http://localhost:3000

# Generate: `openssl rand -hex 32`
# Shared secret for cron job routes (/api/jobs/*). Vercel Cron sends it as
# "Authorization: Bearer <CRON_SECRET>". If unset, job routes refuse all calls.
# Locally, `npm run cron:weekly` / `npm run cron:purge` send it for you.
CRON_SECRET=

# Generate: `openssl rand -hex 32`
# Secret used to sign buyer/admin session cookies (HMAC-SHA256). Use a long
# random value; rotating it invalidates all existing sessions. Required — you
# cannot log in without it, locally or in prod.
SESSION_SECRET=

# Talk spend guards (src/lib/talk/limits.ts). Defaults: 30 turns per 10 min and
# 300 per day, per parent and per IP; 60 voice minutes per parent per day.
# Raise the IP limits for a facility where many residents share one IP.
TALK_LIMIT_PARENT_PER_10_MIN=
TALK_LIMIT_PARENT_PER_DAY=
TALK_LIMIT_IP_PER_10_MIN=
TALK_LIMIT_IP_PER_DAY=
TALK_VOICE_MINUTES_PER_DAY=

# Safety alerts (decision D2). P0/P1 flags alert the gift buyer by email and,
# with an alert phone + SMS consent, by SMS. P3 (abuse, scams) goes ONLY to
# ADMIN_ALERT_EMAIL, never to family; it is also the backup when a P0/P1 can't
# reach the family. Without the TWILIO_* keys (or with DEMO_MODE=true) a fake
# SMS client is used and nothing is sent.
ADMIN_ALERT_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 sender number, e.g. +15551234567
TWILIO_FROM=

# Speech providers for the voice turn (/api/talk/voice).
# If either key is unset, simulated voice is used locally. Both are required on
# production unless DEMO_MODE=true.
# [PAID] Deepgram speech-to-text.
DEEPGRAM_API_KEY=
# [PAID] ElevenLabs text-to-speech.
ELEVENLABS_API_KEY=
# ElevenLabs voice ID. Default: Adam (pNInz6obpgDQGcFmaJgB).
ELEVENLABS_VOICE_ID=

# Billing (Stripe, test mode). The 7-day free trial (card required upfront)
# is built on Checkout + a webhook. Without STRIPE_SECRET_KEY / a plan's
# Price id, the checkout route degrades to a 503 rather than crashing local
# dev/build. See src/lib/billing/config.ts for the single place all of these
# are read and resolved to a PLAN_PRICE_IDS lookup.
#
# [PAID] Secret key for the Stripe API — TEST MODE ONLY (sk_test_/rk_test_)
# outside production. Optional locally: the demo account has a beta plan.
# Use a restricted key (rk_...)
# scoped to Checkout Sessions/Subscriptions/Webhooks where possible.
STRIPE_SECRET_KEY=
# Signing secret for the /api/billing/webhook endpoint. In local dev, get one
# from `stripe listen --forward-to localhost:3000/api/billing/webhook`.
STRIPE_WEBHOOK_SECRET=
# Family Companion plan — monthly recurring Price id. Manual step: name this
# Price's Product "Family Companion" (or equivalent) in the Stripe dashboard
# so it matches the marketing copy in src/lib/content.ts PRICING and doesn't
# drift again — this repo has already shipped and fixed that exact mismatch
# once (see commits 59e1323, e5c5f13).
STRIPE_PRICE_FAMILY_MONTHLY=
# Family Companion plan — annual recurring Price id. Must be the SAME
# Product as STRIPE_PRICE_FAMILY_MONTHLY, a second recurring Price with a
# 1-year interval — not a separate Product.
STRIPE_PRICE_FAMILY_ANNUAL=
# Premium Care plan — monthly recurring Price id.
STRIPE_PRICE_PREMIUM_MONTHLY=
# Premium Care plan — annual recurring Price id. Must be the SAME Product as
# STRIPE_PRICE_PREMIUM_MONTHLY, not a separate Product.
STRIPE_PRICE_PREMIUM_ANNUAL=
# Gift Package — one-time Price id for the 3-month prepaid gift.
STRIPE_PRICE_GIFT_3MONTH=
# Founding Facility Pilot — one-time Price id for the B2B pilot offer.
STRIPE_PRICE_FACILITY_PILOT=

# Founding Family Beta (first 10 invited US families): a 14-day entitlement
# with no card and no Stripe involvement, gated on a one-time invite token
# (see db/migrations/0013_founding_family_beta.sql and
# docs/founding-family-beta.md). Both default to disabled/14 when unset —
# see src/lib/foundingBeta.ts for the exact parsing/bounds.
#
# Must be exactly "true" to enable; any other value (including unset) keeps
# the activation endpoint returning 503 regardless of invite validity.
FOUNDING_FAMILY_BETA_ENABLED=
# Bounded positive integer (1-365). Falls back to 14 if unset or invalid.
FOUNDING_FAMILY_BETA_DAYS=

# [PAID] Error tracking (Sentry; free tier exists). SDK stays idle with no DSN set — safe to leave
# empty in local dev. NEXT_PUBLIC_SENTRY_DSN is for the browser; SENTRY_DSN
# for server/edge. Sentry never receives request bodies (sendDefaultPii: false).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Only needed to upload source maps at build time (nicer stack traces); build
# succeeds without them.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
